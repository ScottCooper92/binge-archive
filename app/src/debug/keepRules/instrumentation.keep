}

-keep class com.binge.companion.contracts.stream.v1.StreamServiceGrpcKt$StreamServiceCoroutineStub {
    java.lang.Object handshake$default(com.binge.companion.contracts.stream.v1.StreamServiceGrpcKt$StreamServiceCoroutineStub,com.binge.companion.contracts.stream.v1.HandshakeRequest,io.grpc.Metadata,kotlin.coroutines.Continuation,int,java.lang.Object);
    java.lang.Object probe$default(com.binge.companion.contracts.stream.v1.StreamServiceGrpcKt$StreamServiceCoroutineStub,com.binge.companion.contracts.stream.v1.ProbeRequest,io.grpc.Metadata,kotlin.coroutines.Continuation,int,java.lang.Object);
    kotlinx.coroutines.flow.Flow resolve$default(com.binge.companion.contracts.stream.v1.StreamServiceGrpcKt$StreamServiceCoroutineStub,com.binge.companion.contracts.stream.v1.ResolveRequest,io.grpc.Metadata,int,java.lang.Object);
    void <init>(io.grpc.Channel,io.grpc.CallOptions,int,kotlin.jvm.internal.DefaultConstructorMarker);
}

