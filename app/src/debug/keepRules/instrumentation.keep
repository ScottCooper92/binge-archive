# Debug only: exactly what the instrumentation test calls in the minified app under test.
#
# When the app under test is minified, the test APK leaves out every library the app already
# carries, and resolves those classes and members from the app at run time. R8 strips what the app
# itself never uses, so the test would fail before it starts (NoClassDefFoundError, "0 tests") or
# mid-way (NoSuchMethodError). The app serves STREAM, so it never builds a request, reads a response
# or calls the gRPC client; the test does all three. These rules keep exactly those members, and
# nothing the lane proves: the Service, the server-side stubs and the messages' own fields still
# stand on the rules in main. Release builds never see this file.
#
# Regenerate after changing the test: `tools/instrumentation-keep/check.sh` builds both APKs and
# prints a rule for every method and field the test APK references that neither APK defines
# (superclasses included). Empty output means this file is complete.
#
# Not kept, because no rule can: androidx.test's ViewCapture and WindowCapture refer to
# androidx.concurrent.futures.SuspendToFutureAdapter, which the concurrent-futures version this app
# resolves (1.1.0) does not have. The smoke test never captures a view, so the gap is never reached.

-keep class androidx.tracing.Trace {
    void forceEnableAppTracing();
}

-keep class com.binge.companion.contracts.stream.v1.HandshakeRequest {
    com.binge.companion.contracts.stream.v1.HandshakeRequest$Builder newBuilder();
}

-keep class com.binge.companion.contracts.stream.v1.HandshakeRequest$Builder {
    com.binge.companion.contracts.stream.v1.HandshakeRequest$Builder setHost(com.binge.companion.contracts.v1.HostInfo$Builder);
}

-keep class com.binge.companion.contracts.stream.v1.HandshakeResponse {
    int getCapabilitiesCount();
    java.lang.String getProviderName();
}

