<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        This app's own mark, the film frame with its play cut-out, inside Binge's progress arc. Same
        construction as Binge's launcher foreground and the same 0.84, so the apps sit together on a
        home screen as one family; the colour is what separates them.
    -->

    <!-- Faint track ring (full circle, r=32 @ 54,54) -->
    <path
        android:pathData="M54,22 A32,32 0 1,0 54,86 A32,32 0 1,0 54,22 Z"
        android:strokeColor="#34D399"
        android:strokeAlpha="0.16"
        android:strokeWidth="6"/>

    <!-- The arc, resting at the same 0.84 as the family's other launcher icons. -->
    <path
        android:name="progressArc"
        android:pathData="M54,22 A32,32 0 1,1 54,86 A32,32 0 1,1 54,22 Z"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:trimPathStart="0"
        android:trimPathEnd="0.84">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="22"
                android:endX="54"
                android:endY="86">
                <item android:offset="0.0" android:color="#FF6EE7B7"/>
                <item android:offset="1.0" android:color="#FF059669"/>
            </gradient>
        </aapt:attr>
    </path>

    <!--
        The film frame scaled 0.6 about the ring's centre, where the sibling apps' discs sit. The play
        triangle and the sprocket holes are cut out (even-odd) rather than painted in the ground
        colour: that lets the gradient show through, and keeps the shape once it is tinted flat.
    -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.6"
        android:scaleY="0.6">
        <path
            android:fillColor="#34D399"
            android:fillType="evenOdd"
            android:pathData="M34,36 h40 a4,4 0 0,1 4,4 v28 a4,4 0 0,1 -4,4 h-40 a4,4 0 0,1 -4,-4 v-28 a4,4 0 0,1 4,-4 z M36,40 v4 h4 v-4 z M36,48 v4 h4 v-4 z M36,56 v4 h4 v-4 z M36,64 v4 h4 v-4 z M68,40 v4 h4 v-4 z M68,48 v4 h4 v-4 z M68,56 v4 h4 v-4 z M68,64 v4 h4 v-4 z M49,46 L61,54 L49,62 Z"/>
    </group>

</vector>
