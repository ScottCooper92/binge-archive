<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The only permission. The app reads Wikidata and the Internet Archive and nothing else. It posts
        no notifications, so it does not ask for that permission either.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Both required="false", so one APK serves phones and televisions. Without the touchscreen line
        Play assumes a touchscreen is required and hides the app from every TV.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        No backup: the app keeps an index it can rebuild and no user data, so there is nothing to
        restore and nothing to leak. The data extraction rules say the same for device transfer.

        The network security config trusts the system's CAs only and refuses cleartext. Both hosts the
        app talks to serve HTTPS.
    -->
    <application
        android:name=".ArchiveApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_label"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            WorkManager's own initializer is removed so it starts from ArchiveApp's configuration, whose
            worker factory hands the refresh worker its collaborators.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Archive">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Binge's "manage" row. Binge resolves it by this action and this package and starts it for a
            result, which gives the Activity a callingPackage to check before it opens the status screen.
            exported="true" makes it reachable by every app, so the check is what guards it.
        -->
        <activity
            android:name=".SettingsHandOffActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.binge.companion.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            exported="true" is the integration surface: Binge reaches this Service with bindService,
            and what guards it is the caller policy in ArchiveCompanionService, not the manifest.
            android:process is absent so the Service runs under this app's own uid, which is what the
            host's certificate check verifies.

            Binge reads the meta-data WITHOUT binding, to list this companion and check that the two
            can parse each other before any process of ours starts. The keys are CompanionManifest's.
        -->
        <service
            android:name=".service.ArchiveCompanionService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.binge.companion.STREAM" />
            </intent-filter>

            <meta-data
                android:name="com.binge.companion.name"
                android:value="@string/companion_label" />
            <meta-data
                android:name="com.binge.companion.icon"
                android:resource="@drawable/ic_companion" />
            <meta-data
                android:name="com.binge.companion.majors"
                android:value="1" />
        </service>
    </application>

</manifest>
